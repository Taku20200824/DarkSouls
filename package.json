{
  "name": "lordran-tracker",
  "version": "0.1.12",
  "license": "MIT",
  "private": true,
  "description": "LORDRAN TRACKER — Dark Souls Remastered companion",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s companion -p \"test_*.py\"",
    "build:desktop": "cross-env ELECTRON_BUILD=1 next build && node build/copy-standalone.mjs",
    "electron:dev": "npm run build:desktop && electron electron/main.js",
    "icon": "node build/make-icon.mjs",
    "bundle:electron": "node build/bundle-electron.mjs",
    "dist:win": "npm run icon && npm run build:desktop && npm run bundle:electron && electron-builder --win --publish never",
    "appx-assets": "node build/make-appx-assets.mjs",
    "dist:store": "npm run icon && npm run appx-assets && npm run build:desktop && npm run bundle:electron && electron-builder --win appx --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/yeseva-one": "^5.3.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "clsx": "^2.1.1",
    "firebase-admin": "^13.10.0",
    "gsap": "^3.15.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "magic-string": "^0.30.21",
    "postcss": "^8.5.32",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
