# ---- Required ----
# Public base URL of the site (used as Steam OpenID realm / return_to). No trailing slash.
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# https://steamcommunity.com/dev/apikey  (server-side only, never exposed to the browser)
STEAM_API_KEY=

# ---- Firebase (Firestore via Admin SDK) ----
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=darksouls-65f0d
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences; they are converted at runtime.
FIREBASE_PRIVATE_KEY=

# ---- Development only ----
# When Firebase is not configured AND NODE_ENV != production, a local JSON file store is used.
# Set to 1 to forbid that fallback even in development.
DISABLE_DEV_STORE=0
